extends ../../layouts/LayoutTheme
include ../../mixins/pages/insider/index
include ../../mixins/pages/insider/blog

append variables
	- var attrsBody = { style: "--phoenix-scroll-margin-top: 1.2rem;"};
	- var disableNavigationType = true;
	- var disableVerticalNavbarAppearance = true;
	- var disableHorizontalNavbarShape = true;
	- var disableHorizontalNavbarAppearance = true;
	- var hideSettingPanel = true;

block mainContent
	- var pageSlug = typeof blogSlug !== 'undefined' ? blogSlug : (typeof slug !== 'undefined' ? slug : 'cluster-buy-playbook');
	- var currentPost = (blogPosts || []).find(post => post.slug === pageSlug) || (blogPosts && blogPosts[0]) || {};
	+InsiderNavbar
	+InsiderBlogDetail(currentPost)
	+InsiderFooter
